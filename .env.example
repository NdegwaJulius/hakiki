# ── App ──────────────────────────────────────────────────────────────────────
# Long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Email address of the admin account
ADMIN_EMAIL=you@example.com

# Public-facing URL of the frontend app (used in password reset emails)
APP_URL=https://keradata.plunlix.co.ke

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./hakiki.db

# PostgreSQL / Supabase (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── API ───────────────────────────────────────────────────────────────────────
API_VERSION=v1
RATE_LIMIT=100/minute
